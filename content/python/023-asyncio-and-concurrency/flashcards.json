{"q":"Coroutine?","a":"Async function execution that can suspend."},{"q":"async def?","a":"Declares a coroutine function."},{"q":"await?","a":"Suspends coroutine for an awaitable result."},{"q":"Event loop?","a":"Coordinator scheduling ready async tasks."},{"q":"Task?","a":"Scheduled coroutine execution."},{"q":"Concurrency?","a":"Overlapping progress on independent work."},{"q":"Parallelism?","a":"Simultaneous work on multiple CPU cores."},{"q":"I/O-bound work?","a":"Work mostly waiting on external operations."},{"q":"CPU-bound work?","a":"Work mostly performing computation."},{"q":"asyncio.run?","a":"Runs top-level coroutine program."},{"q":"asyncio.gather?","a":"Coordinates multiple awaitables."},{"q":"Semaphore?","a":"Limit on simultaneous operations."},{"q":"Timeout?","a":"Maximum permitted wait duration."},{"q":"Cancellation?","a":"Request to stop an async task."},{"q":"Blocking call risk?","a":"Stops event loop progress."},{"q":"time.sleep in async?","a":"Blocking; use asyncio.sleep for demonstration."},{"q":"Rate limit?","a":"Provider cap on requests or tokens."},{"q":"Retry policy?","a":"Rules for retryable failures."},{"q":"Partial failure?","a":"Some concurrent operations fail while others succeed."},{"q":"Async production rule?","a":"Bound concurrency and observe outcomes."}
