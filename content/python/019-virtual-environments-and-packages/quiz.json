{"id":1,"question":"What does a virtual environment isolate?","options":["Python packages","Operating system kernel","Network","Git history"],"answer":"Python packages","explanation":"Each project can use its own installed packages."},{"id":2,"question":"Which command creates a built-in environment?","options":["pip env","python -m venv .venv","python install","venv run"],"answer":"python -m venv .venv","explanation":"venv is included with Python."},{"id":3,"question":"Why use python -m pip?","options":["It formats code","It targets the selected interpreter","It creates Docker images","It hides versions"],"answer":"It targets the selected interpreter","explanation":"The module runs under that python executable."},{"id":4,"question":"What should be committed?","options":["requirements files",".venv directory","Secrets","Global site-packages"],"answer":"requirements files","explanation":"Specifications are portable; environments are machine-local."},{"id":5,"question":"What does a pinned dependency include?","options":["A version","A password","A source file","A directory"],"answer":"A version","explanation":"Pins record a specific package version."},{"id":6,"question":"What verifies active interpreter location?","options":["print(sys.executable)","pip freeze only","mkdir","glob"],"answer":"print(sys.executable)","explanation":"It prints the executable running Python."},{"id":7,"question":"What should CI start from?","options":["A clean environment","A developer global install","A copied .venv","An unpinned package"],"answer":"A clean environment","explanation":"Clean builds reveal missing declarations."},{"id":8,"question":"What does activation normally change?","options":["Command resolution","Source code","Git branch","File encoding"],"answer":"Command resolution","explanation":"python and pip resolve to the environment."},{"id":9,"question":"What does venv not isolate?","options":["Packages","Python executable","Operating-system libraries","Dependencies"],"answer":"Operating-system libraries","explanation":"venv is not a container."},{"id":10,"question":"Where belong secrets?","options":["requirements.txt","Secret management or environment configuration","Source comments",".venv"],"answer":"Secret management or environment configuration","explanation":"Dependencies must not contain credentials."}
